{
  "name": "Google Review Agent - Workflow A (Polling & Draft)",
  "nodes": [
    {
      "id": "Schedule Trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.cron",
      "position": [200, 300],
      "parameters": {
        "triggerTimes": {
          "item": [
            {
              "hour": 0,
              "minute": "*/15"
            }
          ]
        }
      }
    },
    {
      "id": "Get Reviews",
      "name": "GET reviews.list",
      "type": "n8n-nodes-base.httpRequest",
      "position": [400, 300],
      "parameters": {
        "method": "GET",
        "url": "https://mybusiness.googleapis.com/v4/accounts={{$env.ACCOUNT_ID}}/locations={{$env.LOCATION_ID}}/reviews",
        "queryParametersUi": {
          "parameter": [
            {
              "name": "pageSize",
              "value": "50"
            }
          ]
        },
        "authentication": "oAuth2"
      }
    },
    {
      "id": "Read Seen Sheet",
      "name": "Google Sheets - Read Seen",
      "type": "n8n-nodes-base.googleSheets",
      "position": [600, 200],
      "parameters": {
        "operation": "read",
        "sheetId": "{{$env.SEEN_SHEET_ID}}",
        "range": "seen_reviews!A:B"
      }
    },
    {
      "id": "Dedupe Function",
      "name": "Function: Dedupe",
      "type": "n8n-nodes-base.function",
      "position": [600, 380],
      "parameters": {
        "functionCode": "const seenIds = new Set($('Google Sheets - Read Seen').all().map(i => i.json.reviewId));\nconst newReviews = [];\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!seenIds.has(r.reviewId) && !r.reviewReply) {\n    newReviews.push({ json: {\n      reviewId: r.reviewId,\n      reviewer: r.reviewer?.displayName || 'مشتری',\n      rating: r.starRating,\n      comment: r.comment || '',\n      createTime: r.createTime\n    }});\n  }\n}\nreturn newReviews;"
      }
    },
    {
      "id": "Split In Batches",
      "name": "Split In Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [800, 380],
      "parameters": {
        "batchSize": 1
      }
    },
    {
      "id": "Claude Request",
      "name": "Claude API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1000, 380],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "none",
        "headers": {
          "Content-Type": "application/json",
          "anthropic-version": "2023-06-01",
          "x-api-key": "{{$env.ANTHROPIC_API_KEY}}"
        },
        "body": "={\n  \"model\": \"claude-sonnet-4-6\",\n  \"max_tokens\": 400,\n  \"system\": $env.VOICE_SYSTEM_PROMPT,\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"ریویوی جدید:\\nامتیاز: \" + $json[\"rating\"] + \" ستاره\\nاسم مشتری: \" + $json[\"reviewer\"] + \"\\nمتن ریویو: \\\"\" + $json[\"comment\"] + \"\\\"\\n\\nیک پیش‌نویس جواب بنویس.\"\n    }\n  ]\n}"
      }
    },
    {
      "id": "Parse Claude",
      "name": "Function: Parse Claude",
      "type": "n8n-nodes-base.function",
      "position": [1200, 380],
      "parameters": {
        "functionCode": "const out = [];\nfor (const item of $input.all()) {\n  const text = item.json.content[0].text;\n  out.push({ json: { ...item.json._reviewMeta, draft_reply: text }});\n}\nreturn out;"
      }
    },
    {
      "id": "Telegram Send",
      "name": "Telegram sendMessage",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1400, 380],
      "parameters": {
        "method": "POST",
        "url": "https://api.telegram.org/bot{{$env.TELEGRAM_BOT_TOKEN}}/sendMessage",
        "authentication": "none",
        "body": "={\n  \"chat_id\": \"{{$env.OWNER_CHAT_ID}}\",\n  \"text\": \"⭐ \" + $json[\"rating\"] + \" از \" + $json[\"reviewer\"] + \":\\n«\" + $json[\"comment\"] + \"»\\n\\n✍️ پیش‌نویس جواب:\\n\" + $json[\"draft_reply\"],\n  \"reply_markup\": {\n    \"inline_keyboard\": [[\n      {\n        \"text\": \"✅ تأیید\",\n        \"callback_data\": \"approve:\" + $json[\"reviewId\"]\n      },\n      {\n        \"text\": \"✍️ ویرایش\",\n        \"callback_data\": \"edit:\" + $json[\"reviewId\"]\n      }\n    ]]\n  }\n}"
      }
    },
    {
      "id": "Pending Sheet",
      "name": "Google Sheets - Append Pending",
      "type": "n8n-nodes-base.googleSheets",
      "position": [1600, 380],
      "parameters": {
        "operation": "append",
        "sheetId": "{{$env.PENDING_SHEET_ID}}",
        "range": "pending_replies!A:F",
        "valueInputMode": "RAW",
        "options": {
          "valueRange": "={\n            \"values\": [[\n              $json[\"reviewId\"],\n              $json[\"reviewer\"],\n              $json[\"rating\"],\n              $json[\"comment\"],\n              $json[\"draft_reply\"],\n              \"pending\"\n            ]]\n          }"
        }
      }
    }
  ],
  "connections": {
    "Get Reviews": {
      "main": [
        [{ "node": "Dedupe Function", "type": "main", "index": 0 }]
      ]
    },
    "Schedule Trigger": {
      "main": [
        [{ "node": "Get Reviews", "type": "main", "index": 0 }]
      ]
    },
    "Read Seen Sheet": {
      "main": [
        [{ "node": "Dedupe Function", "type": "main", "index": 1 }]
      ]
    },
    "Dedupe Function": {
      "main": [
        [{ "node": "Split In Batches", "type": "main", "index": 0 }]
      ]
    },
    "Split In Batches": {
      "main": [
        [{ "node": "Claude Request", "type": "main", "index": 0 }]
      ]
    },
    "Claude Request": {
      "main": [
        [{ "node": "Parse Claude", "type": "main", "index": 0 }]
      ]
    },
    "Parse Claude": {
      "main": [
        [{ "node": "Telegram Send", "type": "main", "index": 0 }]
      ]
    },
    "Telegram Send": {
      "main": [
        [{ "node": "Google Sheets - Append Pending", "type": "main", "index": 0 }]
      ]
    }
  }
}